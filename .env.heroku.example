# Nao envie este arquivo com valores reais ao GitHub.
# Cole os valores no painel Heroku > Settings > Config Vars.
NODE_ENV=production
MONGODB_URI=mongodb+srv://USUARIO:SENHA@CLUSTER.mongodb.net/motopro?retryWrites=true&w=majority
JWT_SECRET=CHAVE_ALEATORIA_GERADA_LOCALMENTE
APP_ORIGIN=https://SEU-PROJETO.vercel.app
# PORT = definida automaticamente pelo Heroku; nao configurar manualmente
# OPENAI_API_KEY = necessária para transcrição por voz e interpretação de comandos por IA
OPENAI_TRANSCRIPTION_MODEL=gpt-4o-transcribe
OPENAI_COMMAND_MODEL=gpt-4o-mini

# MotoPRO V3 - Mercado Pago (não habilite antes dos testes)
MP_BILLING_ENABLED=false
MP_ACCESS_TOKEN=
MP_WEBHOOK_SECRET=
MP_PUBLIC_ORIGIN=https://SEU-HEROKU.herokuapp.com

# OPCIONAIS: somente usados ao executar npm run admin:create no terminal Heroku.
# Nunca definir a senha do admin em Config Vars nem em arquivos do Git.
# ADMIN_EMAIL=seu@email.com
# ADMIN_NAME=Administrador MotoPRO

# Integração Checkout Transparente / Orders (MotoPRO PIX)
MP_PIX_ACCESS_TOKEN=
MP_PIX_WEBHOOK_SECRET=

# Cartao desabilitado no MotoPRO. Não configure MP_CREDIT_TEST_*.
# MP_ACCESS_TOKEN e MP_WEBHOOK_SECRET são necessários apenas para cancelamento/gestão
# de eventuais assinaturas antigas de cartão. Não removê-los antes de cancelar as recorrências.
# MP_BILLING_ENABLED=true habilita o fluxo Pix. A exigência de assinatura Premium
# agora é configurada em Administração > Configurações (premiumRequired).
# MP_ENFORCE_PREMIUM foi descontinuada a partir da V3.10.

# FASE 1 FINAL — fechamento semanal automático por e-mail (opcional)
# Sem estas configurações, o envio automático fica indisponível;
# os relatórios na tela e o compartilhamento manual continuam funcionando.
# RESEND_API_KEY=re_xxx
# REPORTS_FROM_EMAIL=MotoPRO <relatorios@seudominio.com>
# REPORTS_BATCH_SIZE=80
# Instale Heroku Scheduler e agende: npm run reports:weekly
# Recomendado: execução diária às 12:00 UTC (09:00 no Pará),
# para processar lotes e reexecutar falhas com máximo de 3 tentativas.
# A conta de domínio remetente precisa ser verificada no Resend.
