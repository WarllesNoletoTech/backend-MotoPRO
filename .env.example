# LOCAL - copie para .env e preencha sem compartilhar.
NODE_ENV=development
PORT=4000
MONGODB_URI=mongodb+srv://USUARIO:SENHA@CLUSTER.mongodb.net/motopro?retryWrites=true&w=majority
JWT_SECRET=SUBSTITUA_POR_CHAVE_ALEATORIA_DE_96_CARACTERES
APP_ORIGIN=http://localhost:3000
OPENAI_API_KEY=
OPENAI_TRANSCRIPTION_MODEL=gpt-4o-transcribe
OPENAI_COMMAND_MODEL=gpt-4o-mini

# OPCIONAIS para criar o administrador via terminal (nao colocam role=admin sozinhas)
# ADMIN_EMAIL=seu@email.com
# ADMIN_NAME=Administrador MotoPRO

# Integração Checkout Transparente / Orders (MotoPRO PIX)
MP_PIX_ACCESS_TOKEN=
MP_PIX_WEBHOOK_SECRET=

# Cartao desabilitado no MotoPRO. Não configure MP_CREDIT_TEST_*.
# MP_ACCESS_TOKEN e MP_WEBHOOK_SECRET são necessários apenas para cancelamento/gestão
# de eventuais assinaturas antigas de cartão. Não removê-los antes de cancelar as recorrências.
# MP_BILLING_ENABLED=true habilita o fluxo Pix. A exigência de assinatura Premium
# agora é configurada em Administração > Configurações (premiumRequired).
# MP_ENFORCE_PREMIUM foi descontinuada a partir da V3.10.

# Configuração de backend para integração Rappidex (mesma chave em ambos)
# RAPPIDEX_API_URL=https://SEU_BACKEND_RAPPIDEX.herokuapp.com
# RAPPIDEX_INTEGRATION_SECRET=<chave_aleatoria_32_ou_mais_caracteres>

# Envio de relatórios opcionais (configure somente no ambiente do servidor)
RESEND_API_KEY=
REPORTS_FROM_EMAIL=
REPORTS_BATCH_SIZE=80

# Fase 2 - scanner de comprovantes: usa OPENAI_API_KEY existente.
# Opcional: modelo com visão; caso ausente usa OPENAI_COMMAND_MODEL.
OPENAI_RECEIPT_MODEL=gpt-4o-mini
# Opcional: taxas reais do seu contrato, em USD por 1 milhão de tokens.
# Sem preencher as duas, o painel não calcula custo estimado.
# OPENAI_INPUT_USD_PER_1M=
# OPENAI_OUTPUT_USD_PER_1M=

# Fase 5 - Web Push (todos os valores devem ser definidos apenas no Heroku)
# Execute localmente: npm run push:keys
# NUNCA versionar a chave privada ou compartilhá-la pelo WhatsApp.
PUSH_VAPID_PUBLIC_KEY=
PUSH_VAPID_PRIVATE_KEY=
PUSH_CONTACT_EMAIL=
# Limite de usuários com avisos enviados por execução (máximo 500).
PUSH_BATCH_SIZE=150

# OneSignal - alternativa ao Web Push VAPID, modo exclusivo quando App ID informado.
# App ID é público, mas a REST API Key deve ficar SOMENTE no backend Heroku.
ONESIGNAL_APP_ID=
ONESIGNAL_REST_API_KEY=
